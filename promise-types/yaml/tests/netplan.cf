# Netplan: move an interface from DHCP to a static address
#
# Covers booleans, list membership by value (including under an empty
# 'key:'), a trailing comment on a removed item, and a new key after a
# nested block. The header comment must be preserved.
#
# The promises are applied twice: the first pass must repair the file, the
# second must only keep promises, and the result must match 'expected'.
#
# Run as root, with the module installed in $(sys.workdir)/modules/promises:
#   cf-agent -KIf ./netplan.cf
body common control
{
  bundlesequence => { "init", "test", "check", "cleanup" };
}

promise agent yaml
{
  path => "$(sys.workdir)/modules/promises/yaml_promise_type.py";
  interpreter => "/usr/bin/python3";
}

body classes outcome(prefix)
{
  promise_kept => { "$(prefix)_kept" };
  promise_repaired => { "$(prefix)_repaired" };
  repair_failed => { "$(prefix)_failed" };
  scope => "namespace";
}

body delete remove_file
{
  dirlinks => "delete";
}

bundle common g
{
  vars:
    "file" string => "/tmp/yaml-promise-type-test-netplan.yaml";

    "start"
      string => "# This file is managed by the network team
network:
  version: 2
  ethernets:
    eth0:
      dhcp4: true
      addresses:
        - 192.168.1.10/24
      nameservers:
        search:
        addresses:
          - 8.8.8.8
          - 8.8.4.4 # old secondary
";

    "expected"
      string => "# This file is managed by the network team
network:
  version: 2
  ethernets:
    eth0:
      dhcp4: false
      addresses:
        - 10.0.0.5/24
      nameservers:
        search:
          - example.com
        addresses:
          - 8.8.8.8
          - 1.1.1.1
      mtu: 9000
";
}

bundle agent init
{
  files:
    "$(g.file)"
      create => "true",
      content => "$(g.start)";
}

bundle agent test
{
  methods:
    "first pass" usebundle => apply("first");
    "second pass" usebundle => apply("second");
}

bundle agent apply(pass)
{
  yaml:
    # Written as a boolean, not the string "false"
    "$(g.file)"
      filter => ".network.ethernets.eth0.dhcp4",
      operation => "set",
      value => "false",
      classes => outcome("$(pass)");

    "$(g.file)"
      filter => ".network.ethernets.eth0.addresses",
      operation => "absent",
      value => "192.168.1.10/24",
      classes => outcome("$(pass)");

    "$(g.file)"
      filter => ".network.ethernets.eth0.addresses",
      operation => "present",
      value => "10.0.0.5/24",
      classes => outcome("$(pass)");

    # 'search:' has no value yet, the list is created under it
    "$(g.file)"
      filter => ".network.ethernets.eth0.nameservers.search",
      operation => "present",
      value => "example.com",
      classes => outcome("$(pass)");

    "$(g.file)"
      filter => ".network.ethernets.eth0.nameservers.addresses",
      operation => "absent",
      value => "8.8.4.4",
      classes => outcome("$(pass)");

    "$(g.file)"
      filter => ".network.ethernets.eth0.nameservers.addresses",
      operation => "present",
      value => "1.1.1.1",
      classes => outcome("$(pass)");

    "$(g.file)"
      filter => ".network.ethernets.eth0.mtu",
      operation => "set",
      value => "9000",
      classes => outcome("$(pass)");
}

bundle agent check
{
  vars:
    "actual"
      string => readfile("$(g.file)", 0),
      if => fileexists("$(g.file)");

  classes:
    "content_ok" expression => strcmp("$(actual)", "$(g.expected)");
    "first_ok" expression => "first_repaired.!first_failed";
    "second_ok" expression => "second_kept.!(second_repaired|second_failed)";
    "ok" and => { "content_ok", "first_ok", "second_ok" };

  reports:
    ok::
      "$(this.promise_filename) Pass";

    !ok::
      "$(this.promise_filename) FAIL";

    !content_ok::
      "Expected:
$(g.expected)";
      "Actual:
$(actual)";

    !first_ok::
      "First pass did not repair cleanly: $(with)"
        with => join(", ", classesmatching("first_.*"));

    !second_ok::
      "Second pass was not a no-op: $(with)"
        with => join(", ", classesmatching("second_.*"));
}

bundle agent cleanup
{
  files:
    "$(g.file)" delete => remove_file;
}
