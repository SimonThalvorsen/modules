# Kubernetes: roll out a new version of a deployment
#
# Covers select() on lists of mappings (containers, env vars), chained
# filters, quoting style and trailing comments being kept, and keys with
# dots and slashes.
#
# The promises are applied twice: the first pass must repair the file, the
# second must only keep promises, and the result must match 'expected'.
#
# Run as root, with the module installed in $(sys.workdir)/modules/promises:
#   cf-agent -KIf ./kubernetes.cf
body common control
{
  bundlesequence => { "init", "test", "check", "cleanup" };
}

promise agent yaml
{
  path => "$(sys.workdir)/modules/promises/yaml_promise_type.py";
  interpreter => "/usr/bin/python3";
}

body classes outcome(prefix)
{
  promise_kept => { "$(prefix)_kept" };
  promise_repaired => { "$(prefix)_repaired" };
  repair_failed => { "$(prefix)_failed" };
  scope => "namespace";
}

body delete remove_file
{
  dirlinks => "delete";
}

bundle common g
{
  vars:
    "file" string => "/tmp/yaml-promise-type-test-kubernetes.yaml";

    "start"
      string => "apiVersion: apps/v1
kind: Deployment
metadata:
  name: shop
  labels:
    app.kubernetes.io/name: shop
spec:
  replicas: 2
  template:
    spec:
      containers:
        - name: app
          image: \"registry.example.com/shop:1.4.0\"
          args:
            - --port=8080
          env:
            - name: LOG_LEVEL
              value: info # use debug when troubleshooting
            - name: LEGACY_CHECKOUT
              value: \"on\"
        - name: log-shipper
          image: fluent/fluent-bit:2.1
";

    "expected"
      string => "apiVersion: apps/v1
kind: Deployment
metadata:
  name: shop
  labels:
    app.kubernetes.io/name: shop
    app.kubernetes.io/version: 1.5.0
spec:
  replicas: 3
  template:
    spec:
      containers:
        - name: app
          image: \"registry.example.com/shop:1.5.0\"
          args:
            - --port=8080
            - --metrics
          env:
            - name: LOG_LEVEL
              value: debug # use debug when troubleshooting
";
}

bundle agent init
{
  files:
    "$(g.file)"
      create => "true",
      content => "$(g.start)";
}

bundle agent test
{
  methods:
    "first pass" usebundle => apply("first");
    "second pass" usebundle => apply("second");
}

bundle agent apply(pass)
{
  yaml:
    "$(g.file)"
      filter => ".spec.replicas",
      operation => "set",
      value => "3",
      classes => outcome("$(pass)");

    "$(g.file)"
      filter => '.metadata.labels["app.kubernetes.io/version"]',
      operation => "set",
      value => "1.5.0",
      classes => outcome("$(pass)");

    # Double quotes are kept
    "$(g.file)"
      filter => '.spec.template.spec.containers[] | select(.name == "app") | .image',
      operation => "set",
      value => "registry.example.com/shop:1.5.0",
      classes => outcome("$(pass)");

    "$(g.file)"
      filter => '.spec.template.spec.containers[] | select(.name == "app") | .args',
      operation => "present",
      value => "--metrics",
      classes => outcome("$(pass)");

    # Trailing comment is kept
    "$(g.file)"
      filter => '.spec.template.spec.containers[] | select(.name == "app") | .env[] | select(.name == "LOG_LEVEL") | .value',
      operation => "set",
      value => "debug",
      classes => outcome("$(pass)");

    "$(g.file)"
      filter => '.spec.template.spec.containers[] | select(.name == "app") | .env[] | select(.name == "LEGACY_CHECKOUT")',
      operation => "absent",
      classes => outcome("$(pass)");

    # Removes the whole container, found by name rather than position
    "$(g.file)"
      filter => '.spec.template.spec.containers[] | select(.name == "log-shipper")',
      operation => "absent",
      classes => outcome("$(pass)");
}

bundle agent check
{
  vars:
    "actual"
      string => readfile("$(g.file)", 0),
      if => fileexists("$(g.file)");

  classes:
    "content_ok" expression => strcmp("$(actual)", "$(g.expected)");
    "first_ok" expression => "first_repaired.!first_failed";
    "second_ok" expression => "second_kept.!(second_repaired|second_failed)";
    "ok" and => { "content_ok", "first_ok", "second_ok" };

  reports:
    ok::
      "$(this.promise_filename) Pass";

    !ok::
      "$(this.promise_filename) FAIL";

    !content_ok::
      "Expected:
$(g.expected)";
      "Actual:
$(actual)";

    !first_ok::
      "First pass did not repair cleanly: $(with)"
        with => join(", ", classesmatching("first_.*"));

    !second_ok::
      "Second pass was not a no-op: $(with)"
        with => join(", ", classesmatching("second_.*"));
}

bundle agent cleanup
{
  files:
    "$(g.file)" delete => remove_file;
}
