promise agent ansible
# @brief Define ansible promise type
{
  path => "$(sys.workdir)/modules/promises/ansible_promise.sh";
  interpreter => "/bin/sh";
}

bundle agent main
{
  ansible:
    "my_playbook"
      playbook => "/tmp/playbook.yaml",
      inventory => "/tmp/inventory.yaml",
      tags => { "helloworld" };
}
